# Salin menjadi .env di server, isi nilainya di sana. Jangan kirim isi .env ke chat mana pun.

# Alamat Karakeep dari dalam jaringan Docker (nama container web Karakeep)
KARAKEEP_BASE_URL=http://karakeep-web-1:3000

# API key Karakeep KHUSUS Poci web (buat baru di dashboard: Settings > API Keys, nama: poci-web, Full Access)
KARAKEEP_API_KEY=ISI_DI_SERVER

# Login Poci (bebas kamu tentukan sendiri)
POCI_USERNAME=naufal
POCI_PASSWORD=ISI_DI_SERVER

# Kunci acak untuk cookie session, buat dengan: openssl rand -hex 32
SESSION_SECRET=ISI_DI_SERVER

# Login Google (OAuth) - buat OAuth client bertipe Web application di Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Hanya email terverifikasi ini yang boleh masuk lewat Google
GOOGLE_ALLOWED_EMAIL=
GOOGLE_REDIRECT_URI=https://poci.ruangkendali.ai.id/auth/google/callback

# Login password cadangan: on selama transisi, ganti off sesudah login Google terbukti jalan
POCI_PASSWORD_LOGIN=on
