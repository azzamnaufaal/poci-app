# Salin menjadi .env di server, isi nilainya di sana. Jangan kirim isi .env ke chat mana pun.
# Tidak ada login kata sandi dan tidak ada allowlist email di build ini:
# masuk hanya lewat Google, anggota hanya lewat undangan di aplikasi.

# Alamat Karakeep dari dalam jaringan Docker (nama container web Karakeep)
KARAKEEP_BASE_URL=http://karakeep-web-1:3000

# Kunci API Karakeep milik pemilik dari penyiapan lama (opsional).
# Bila diisi, kunci ini dipakai sebagai kunci pemilik dan provisioning
# pemilik dilewati. Bila kosong, pemilik dibuatkan akun mesin otomatis
# saat login pertama, memakai kunci admin di bawah.
KARAKEEP_API_KEY=

# Kunci admin Karakeep (scope admin, dipakai hanya server untuk
# provisioning akun anggota dan pemicu massal penandaan). Wajib diisi
# supaya undangan anggota bisa dibuatkan akun mesin otomatis.
KARAKEEP_ADMIN_API_KEY=

# Email pemilik (admin tunggal). Bila diisi, hanya email ini yang bisa
# menjadi pemilik saat login pertama. Bila kosong, login Google pertama
# menjadi pemilik. Sesudah pemilik ada, semua login lain wajib undangan.
POCI_OWNER_EMAIL=

# Kunci acak untuk cookie session, buat dengan: openssl rand -hex 32
SESSION_SECRET=ISI_DI_SERVER

# Login Google (OAuth): OAuth client bertipe Web application di Google Cloud Console.
# Redirect URI yang didaftarkan harus sama persis dengan alamat callback aplikasi.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pengingat Telegram khusus pemilik (opsional). Bot token dan chat id
# pemilik diisi operator server; tanpa keduanya, saklar pengingat
# menolak menyala dan menampilkan pesan perlunya penautan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Cookie sesi hanya lewat HTTPS. Set 0 hanya untuk uji lokal lewat HTTP.
SESSION_COOKIE_HTTPS_ONLY=1

# Direktori data Pocil (berkas SQLite akun, undangan, dan perangkat).
# Di compose, direktori ini di-mount sebagai volume.
POCIL_DATA_DIR=/data
